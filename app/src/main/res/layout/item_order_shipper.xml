<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <TableRow>
        <TextView
            android:text="Khách:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/tvOrderCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
    </TableRow>

    <TableRow>
        <TextView
            android:text="Địa chỉ:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/tvOrderAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="123 Đường ABC, Quận 1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
    </TableRow>

    <TableRow>
        <TextView
            android:text="SĐT:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/tvOrderPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0901234567"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
    </TableRow>

    <TableRow>
        <TextView
            android:text="Trạng thái:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang giao"
            android:textColor="#FFEB3B"
            android:textStyle="italic"
            android:textSize="14sp"/>
    </TableRow>

    <TableRow>
        <TextView
            android:text="Giá tiền:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/tvOrderPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150.000đ"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:textSize="14sp"/>
    </TableRow>

    <TableRow>
        <Button
            android:id="@+id/btnMarkDelivered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã giao xong"
            android:textColor="#FFFFFF"
            android:background="@android:color/holo_green_dark"
            android:layout_marginTop="8dp"/>
    </TableRow>

</TableLayout> 